# Copy this to .env and fill in your values.
# Never commit .env to version control.

# GitHub personal access token - needs repo scope
# (read issues, write comments, apply labels, close issues).
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# Anthropic API key - only needed for --provider anthropic (the default).
# Not needed when running with --provider ollama.
# Get one at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your_key_here
